# --- Access control ---------------------------------------------------------
# Shared household password. When set, every page requires sign-in.
# Leave unset for open local development.
APP_PASSWORD=pick-a-strong-shared-password

# Names offered on the login screen (comma separated). Optional.
HOUSEHOLD_MEMBERS=Arda,Meriç

# Optional: rotate sessions without changing the password.
# AUTH_SECRET=any-long-random-string

# --- AI advisor --------------------------------------------------------------
# Required for the natural-language advisor (Advisor tab).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the advisor model (defaults to claude-opus-4-8)
# ADVISOR_MODEL=claude-opus-4-8
